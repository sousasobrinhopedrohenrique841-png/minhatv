<div class="help">

    MENU = M<br>
    GUIA = G<br>
    ← → = Canal<br>
    ENTER = Selecionar

</div>


<!-- ===================================================
     BARRA DE CANAIS
=================================================== -->

<div
    class="channelBar"
    id="channelBar">
</div>


<!-- ===================================================
     MENU LATERAL
=================================================== -->

<div
    class="sidebar"
    id="sidebar">

    <div class="menuTitle">
        Menu
    </div>

    <div
        class="menuItem"
        tabindex="0"
        onclick="fecharMenu()">

        📺 TV ao vivo

    </div>

    <div
        class="menuItem"
        tabindex="0"
        onclick="abrirGuia()">

        📅 Guia de programação

