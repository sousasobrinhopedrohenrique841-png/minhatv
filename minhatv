<script>

/* =====================================================
   LISTA DE CANAIS

   COLOQUE AQUI OS LINKS OFICIAIS/AUTORIZADOS
===================================================== */

const canais = [

    {
        numero: "001",
        nome: "Globo",
        programa: "Transmissão ao vivo",
        url: "COLOQUE_AQUI_O_LINK_OFICIAL"
    },

    {
        numero: "002",
        nome: "SBT",
        programa: "Transmissão ao vivo",
        url: "COLOQUE_AQUI_O_LINK_OFICIAL"
    },

    {
        numero: "003",
        nome: "Canal 3",
        programa: "Transmissão ao vivo",
        url: "COLOQUE_AQUI_O_LINK"
    },

    {
        numero: "004",
        nome: "Canal 4",
        programa: "Transmissão ao vivo",
        url: "COLOQUE_AQUI_O_LINK"
    },

    {
        numero: "005",
        nome: "Canal 5",
        programa: "Transmissão ao vivo",
        url: "COLOQUE_AQUI_O_LINK"
    }

];


/* =====================================================
   ELEMENTOS
===================================================== */

const player =
    document.getElementById("player");

const channelBar =
    document.getElementById("channelBar");

const channelName =
    document.getElementById("channelName");

const channelNumber =
    document.getElementById("channelNumber");

const program =
    document.getElementById("program");

const loading =
    document.getElementById("loading");

const sidebar =
    document.getElementById("sidebar");

const guide =
    document.getElementById("guide");

let canalAtual = 0;


/* =====================================================
   CRIAR CANAIS
===================================================== */

function criarCanais() {

    channelBar.innerHTML = "";

    canais.forEach((canal, index) => {

        const card =
            document.createElement("div");

        card.className = "channelCard";

        card.tabIndex = 0;

        card.innerHTML = `

            <div class="number">
                ${canal.numero}
            </div>

            <div class="name">
                ${canal.nome}
            </div>

            <div class="liveText">
                ● AO VIVO
            </div>

        `;

        card.onclick = () => {

            selecionarCanal(index);

        };

        card.onkeydown = event => {

            if (
                event.key === "Enter" ||
                event.key === " "
            ) {

                selecionarCanal(index);

            }

        };

        channelBar.appendChild(card);

    });

    atualizarInterface();

}


/* =====================================================
   SELECIONAR CANAL
===================================================== */

function selecionarCanal(index) {

    if (!canais[index])
        return;

    canalAtual = index;

    const canal =
        canais[index];

    channelName.textContent =
        canal.nome;

    channelNumber.textContent =
        canal.numero;

    program.textContent =
        canal.programa;

    atualizarInterface();

    loading.classList.add("show");

    player.pause();

    player.src =
        canal.url;

    player.load();

    player.play()
        .then(() => {

            loading.classList.remove("show");

        })
        .catch(() => {

            loading.classList.remove("show");

        });

}


/* =====================================================
   ATUALIZAR INTERFACE
===================================================== */

function atualizarInterface() {

    const cards =
        document.querySelectorAll(
            ".channelCard"
        );

    cards.forEach(
        (card, index) => {

            card.classList.toggle(
                "active",
                index === canalAtual
            );

        }
    );

}


/* =====================================================
   PRÓXIMO CANAL
===================================================== */

function proximoCanal() {

    if (
        canalAtual <
        canais.length - 1
    ) {

        selecionarCanal(
            canalAtual + 1
        );

    } else {

        selecionarCanal(0);

    }

}


/* =====================================================
   CANAL ANTERIOR
===================================================== */

function canalAnterior() {

    if (canalAtual > 0) {

        selecionarCanal(
            canalAtual - 1
        );

    } else {

        selecionarCanal(
            canais.length - 1
        );

    }

}


/* =====================================================
   MENU
===================================================== */

function abrirMenu() {

    sidebar.classList.add("open");

}

function fecharMenu() {

    sidebar.classList.remove("open");

}


/* =====================================================
   GUIA
===================================================== */

function abrirGuia() {

    guide.classList.add("open");

    fecharMenu();

}

function fecharGuia() {

    guide.classList.remove("open");

}


/* =====================================================
   SOM
===================================================== */

function toggleMute() {

    player.muted =
        !player.muted;

}


/* =====================================================
   FULLSCREEN
===================================================== */

function toggleFullscreen() {

    if (
        document.fullscreenElement
    ) {

        document.exitFullscreen();

    } else {

        if (
            document.documentElement
                .requestFullscreen
        ) {

            document.documentElement
                .requestFullscreen();

        }

    }

}


/* =====================================================
   RELÓGIO
===================================================== */

function atualizarRelogio() {

    const agora =
        new Date();

    const horas =
        String(
            agora.getHours()
        ).padStart(2, "0");

    const minutos =
        String(
            agora.getMinutes()
        ).padStart(2, "0");

    document
        .getElementById("clock")
        .textContent =
        `${horas}:${minutos}`;

}

setInterval(
    atualizarRelogio,
    1000
);

atualizarRelogio();


/* =====================================================
   CONTROLE PELO TECLADO / CONTROLE XBOX
===================================================== */

document.addEventListener(
    "keydown",
    event => {

        switch(event.key) {

            case "ArrowRight":

                fecharMenu();
                fecharGuia();

                proximoCanal();

                break;


            case "ArrowLeft":

                fecharMenu();
                fecharGuia();

                canalAnterior();

                break;


            case "ArrowUp":

                break;


            case "ArrowDown":

                break;


            case "Enter":

                break;


            case "m":
            case "M":

                if (
                    sidebar.classList.contains(
                        "open"
                    )
                ) {

                    fecharMenu();

                } else {

                    abrirMenu();

                }

                break;


            case "g":
            case "G":

                if (
                    guide.classList.contains(
                        "open"
                    )
                ) {

                    fecharGuia();

                } else {

                    abrirGuia();

                }

                break;


            case "Escape":

                fecharMenu();

                fecharGuia();

                break;


            case "f":
            case "F":

                toggleFullscreen();

                break;


            case " ":

                event.preventDefault();

                if (player.paused) {

                    player.play();

                } else {

                    player.pause();

                }

                break;

        }

    }
);


/* =====================================================
   ERRO DE VÍDEO
===================================================== */

player.addEventListener(
    "error",
    () => {

        loading.classList.remove(
            "show"
        );

        console.log(
            "Erro na transmissão."
        );

    }
);


/* =====================================================
   INICIALIZAÇÃO
===================================================== */

criarCanais();

</script>

</body>
</html>
